    "name": "Hartland Esports",
    "school": "Hartland High School",
    "heroTitle": "Hartland Eagles Esports",
    "heroText": "Varsity and JV teams from Hartland High School, competing in the Michigan High School Esports League and on the national stage in the USAEL Open.",
    "aboutTitle": "Built to compete",
    "aboutText": "Hartland Esports gives students a team to belong to, coaches who push them, and a real path to compete for state and national titles. Players practice together in the High School Esports Lab, compete against schools across Michigan, and represent the Eagles every match day.",
    "lab": "Hartland High School Esports Lab, just inside the High School Media Center",
    "teamsIntro": "Our varsity and JV teams compete in the Michigan High School Esports League, with Fortnite Varsity #1 also competing nationally in the USAEL Open."
  },
  "seasons": [
    {
      "name": "Fall season",
      "when": "Late August – early December",
      "text": "Our main season. Teams compete weekly, building to the Fall State Championship on the first weekend of December."
    },
    {
      "name": "Winter break",
      "when": "December – mid January",
      "text": "We break for the holidays."
    },
    {
      "name": "Practices & walk-ons",
      "when": "Last two weeks of January",
      "text": "Practices pick back up, with a brief walk-on period for new players."
    },
    {
      "name": "Winter/Spring season",
      "when": "February – May",
      "text": "Our highly competitive season. We select our top teams, often combining rosters, for one last push. Winning state qualifies a team for the national stage, and spring is the last chance to earn it if we didn't in the fall."
    }
  ],
