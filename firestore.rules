rules_version = '2';
// Hartland Esports score database.
// Anyone can READ scores (the website and stream overlay need that).
// Only the coaches listed below can CHANGE anything.
// To change who can edit: update this list, then paste this whole file into
// Firebase console > Firestore > Rules and click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isCoach() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'cameronmontney@hartlandschools.us',
          'jasonwatkins@hartlandschools.us'
        ];
    }

    function validMatch() {
      let d = request.resource.data;
      return d.status in ['upcoming', 'live', 'review', 'final', 'postponed', 'canceled']
        && d.season is string && d.season.size() <= 9
        && d.startsAt is string
        && d.score.us is int && d.score.them is int
        && d.games is list && d.games.size() <= 15;
    }

    // Student scorekeepers: a @hartlandschools.us member a coach marked "Scorekeeper" in Scouting > Members.
    // They can add and score matches for their own teams only, and update the summaries the website reads.
    function scorerDoc() { return /databases/$(database)/documents/scoutMembers/$(request.auth.token.email.lower()); }
    function isScorer() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@hartlandschools[.]us$')
        && exists(scorerDoc()) && get(scorerDoc()).data.scorekeeper == true;
    }
    function scoresTeam(teamId) { return isScorer() && teamId in get(scorerDoc()).data.teams; }

    match /matches/{matchId} {
      allow read: if true;
      // Students can't make a result official: "final" is for coaches; students submit it as "review".
      // A match that's already final is coaches-only.
      allow create: if validMatch() && (isCoach() || (scoresTeam(request.resource.data.teamId) && request.resource.data.status != 'final'));
      allow update: if validMatch() && (isCoach() || (scoresTeam(resource.data.teamId) && scoresTeam(request.resource.data.teamId)
        && resource.data.status != 'final' && request.resource.data.status != 'final'));
      allow delete: if isCoach();
    }

    // Small summary documents the website reads (scores strip, etc.)
    match /public/{docId} {
      allow read: if true;
      allow write: if isCoach() || (isScorer() && (docId in ['scoreboard', 'broadcast'] || docId.matches('season-.*')));
    }

    // LevelUP Remote: OBS on each streaming PC reports its scene names, the scene on air and replay buffer state here,
    // so the scorekeeper can show scene buttons. Written by a browser source inside OBS (not signed in), so it only
    // accepts that small, fixed shape. Commands to OBS go through public/broadcast, which only coaches/scorers can write.
    match /obsState/{station} {
      allow read: if true;
      allow write: if station in ['1', '2', '3', '4']
        && request.resource.data.keys().hasOnly(['scenes', 'current', 'replayBuffer', 'streaming', 'recording', 'level', 'at', 'reader'])
        && (!('reader' in request.resource.data) || (request.resource.data.reader is string && request.resource.data.reader.size() <= 120))
        && request.resource.data.scenes is string && request.resource.data.scenes.size() <= 4000
        && request.resource.data.current is string && request.resource.data.current.size() <= 120
        && request.resource.data.replayBuffer is bool && request.resource.data.streaming is bool && request.resource.data.recording is bool
        && request.resource.data.level is int && request.resource.data.at is string && request.resource.data.at.size() <= 40;
    }

    // ---------- Team scouting (scout/) ----------
    // PRIVATE. Coaches see and edit everything. A player sees nothing until a coach adds their
    // @hartlandschools.us email to scoutMembers with at least one team; then they can read reports for
    // those teams' games and post notes. Members marked captain can also create and edit those reports.
    function myEmail() { return request.auth.token.email.lower(); }
    function inDistrict() {
      return request.auth != null && request.auth.token.email_verified == true
        && myEmail().matches('.*@hartlandschools[.]us$');
    }
    function memberDoc() { return /databases/$(database)/documents/scoutMembers/$(myEmail()); }
    function isMember() { return inDistrict() && exists(memberDoc()); }
    function canSee(game) { return isCoach() || (isMember() && game in get(memberDoc()).data.games); }
    function canEdit(game) { return isCoach() || (isMember() && get(memberDoc()).data.captain == true && game in get(memberDoc()).data.games); }
    function validReport() {
      let d = request.resource.data;
      return d.game is string && d.school is string && d.school.size() <= 120
        && d.plan is string && d.plan.size() <= 20000
        && d.tendencies is string && d.tendencies.size() <= 20000
        && d.picks is string && d.picks.size() <= 20000
        && d.players is list && d.players.size() <= 40
        && d.vods is list && d.vods.size() <= 40
        && (!('statGames' in d) || (d.statGames is list && d.statGames.size() <= 60));
    }

    match /scoutMembers/{email} {
      allow read: if isCoach() || (inDistrict() && email == myEmail());
      allow write: if isCoach();
    }
    match /scoutReports/{reportId} {
      allow read: if canSee(resource.data.game);
      allow create: if canEdit(request.resource.data.game) && validReport();
      allow update: if canEdit(resource.data.game) && request.resource.data.game == resource.data.game && validReport();
      allow delete: if isCoach();

      match /notes/{noteId} {
        function reportGame() { return get(/databases/$(database)/documents/scoutReports/$(reportId)).data.game; }
        allow read: if canSee(resource.data.game);
        allow create: if canSee(reportGame())
          && request.resource.data.game == reportGame()
          && request.resource.data.author == myEmail()
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000;
        allow update: if canSee(resource.data.game) && resource.data.author == myEmail()
          && request.resource.data.author == resource.data.author
          && request.resource.data.game == resource.data.game
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000;
        allow delete: if (canSee(resource.data.game) && resource.data.author == myEmail()) || canEdit(resource.data.game);
      }
    }

    // ---------- Rocket League stats from the stream ----------
    // The stream's score bug isn't signed in. When a game ends it may ADD one box score here, only for a match
    // that is live or final, with a fixed shape. Nobody but coaches can read, change or delete them; a coach
    // applies each one in the scorekeeper (Hartland's stats to the match, the opponent's to scouting).
    function validRLBox(id) {
      let d = request.resource.data;
      let m = /databases/$(database)/documents/matches/$(d.matchId);
      return d.keys().hasOnly(['matchId', 'at', 'guid', 'us', 'winner', 'goals', 'players'])
        && d.matchId is string && d.matchId.size() > 0 && d.matchId.size() <= 64
        && id.matches(d.matchId + '_[A-Za-z0-9-]{1,80}')
        && exists(m) && get(m).data.status in ['live', 'final']
        && d.at is string && d.at.size() <= 40
        && d.guid is string && d.guid.size() <= 80
        && d.us in [0, 1] && d.winner in [0, 1]
        && d.goals is list && d.goals.size() == 2
        && d.players is list && d.players.size() <= 10;
    }
    // Scoreboard reader: the LevelUP Remote in OBS reads the game's scoreboard and drops what it read here
    // ({matchId}_tab while a map is going, {matchId}_final from the end-of-map screen). Gamertags of both teams, so
    // only coaches and scorekeepers can read it; the scorekeeper applies ours to the match and theirs to scouting.
    function validRead(id) {
      let d = request.resource.data;
      let m = /databases/$(database)/documents/matches/$(d.matchId);
      return d.keys().hasOnly(['matchId', 'kind', 'at', 'src', 'us', 'them'])
        && d.matchId is string && d.matchId.size() > 0 && d.matchId.size() <= 64
        && d.kind in ['tab', 'final'] && id == d.matchId + '_' + d.kind
        && exists(m) && get(m).data.status == 'live'
        && d.at is string && d.at.size() <= 40 && d.src is string && d.src.size() <= 80
        && d.us is list && d.us.size() <= 6 && d.them is list && d.them.size() <= 6;
    }
    match /liveStats/{readId} {
      allow create, update: if validRead(readId);
      allow read, delete: if isCoach() || isScorer();
    }

    match /rlInbox/{boxId} {
      allow create: if validRLBox(boxId);
      allow read, delete: if isCoach() || isScorer();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
